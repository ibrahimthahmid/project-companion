<%- include('partials/header', { active: 'dashboard' }) %>

<h1>Dashboard</h1>

<div class="card-row">
  <div class="card">
    <div class="card-header">To Do</div>
    <div class="card-value"><%= counts['To Do'] %></div>
  </div>
  <div class="card">
    <div class="card-header">In Progress</div>
    <div class="card-value"><%= counts['In Progress'] %></div>
  </div>
  <div class="card">
    <div class="card-header">Complete</div>
    <div class="card-value"><%= counts['Complete'] %></div>
  </div>
  <div class="card">
    <div class="card-header">Total</div>
    <div class="card-value"><%= totalTasks %></div>
  </div>
</div>

<% if (overdueRisks.length > 0) { %>
  <h2>Risks past review date</h2>
  <div class="alert-box">
    <% overdueRisks.forEach(risk => { %>
      <div class="alert-item">
        <span class="alert-icon" aria-hidden="true">!</span>
        <span><%= risk.description %></span>
        <span class="alert-date">Review: <%= risk.review_date %></span>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (unmitigatedRisks.length > 0) { %>
  <h2>Open risks without a mitigation action</h2>
  <div class="info-box">
    <% unmitigatedRisks.forEach(risk => { %>
      <div class="info-item">
        <span><%= risk.description %></span>
        <a href="/risks/<%= risk.id %>/edit" class="info-link">Link a mitigation task</a>
      </div>
    <% }); %>
  </div>
<% } %>

<h2>Recent tasks</h2>
<table class="data-table">
  <thead>
    <tr>
      <th scope="col">Task</th>
      <th scope="col">Phase</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
    <% recentTasks.forEach(task => { %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.phase %></td>
        <td>
          <span class="status-badge status-<%= task.status.toLowerCase().replace(/\s/g, '-') %>">
            <%= task.status %>
          </span>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/footer') %>
