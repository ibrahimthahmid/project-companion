<%- include('../partials/header', { active: 'literature' }) %>

<h1>Edit source</h1>

<form method="post" action="/literature/<%= item.id %>" class="form-card">
  <div class="form-group">
    <label for="author">Author(s)</label>
    <input type="text" id="author" name="author" value="<%= item.author %>">
  </div>
  <div class="form-group">
    <label for="title">Title <span class="required">*</span></label>
    <input type="text" id="title" name="title" required value="<%= item.title %>">
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="year">Year</label>
      <input type="number" id="year" name="year" min="1900" max="2100" value="<%= item.year || '' %>">
    </div>
    <div class="form-group">
      <label for="source_type">Source type</label>
      <select id="source_type" name="source_type">
        <% ['Journal article','Book','Website','Standard','Report','Other'].forEach(t => { %>
          <option value="<%= t %>" <%= item.source_type === t ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div class="form-group">
    <label for="notes">Notes on how this source contributes to the project</label>
    <textarea id="notes" name="notes" rows="3"><%= item.notes %></textarea>
  </div>

  <h2 class="form-section-title">PROMPT evaluation</h2>
  <div class="form-group">
    <label for="prompt_presentation">Presentation</label>
    <textarea id="prompt_presentation" name="prompt_presentation" rows="2"><%= item.prompt_presentation %></textarea>
  </div>
  <div class="form-group">
    <label for="prompt_relevance">Relevance</label>
    <textarea id="prompt_relevance" name="prompt_relevance" rows="2"><%= item.prompt_relevance %></textarea>
  </div>
  <div class="form-group">
    <label for="prompt_objectivity">Objectivity</label>
    <textarea id="prompt_objectivity" name="prompt_objectivity" rows="2"><%= item.prompt_objectivity %></textarea>
  </div>
  <div class="form-group">
    <label for="prompt_method">Method</label>
    <textarea id="prompt_method" name="prompt_method" rows="2"><%= item.prompt_method %></textarea>
  </div>
  <div class="form-group">
    <label for="prompt_provenance">Provenance</label>
    <textarea id="prompt_provenance" name="prompt_provenance" rows="2"><%= item.prompt_provenance %></textarea>
  </div>
  <div class="form-group">
    <label for="prompt_timeliness">Timeliness</label>
    <textarea id="prompt_timeliness" name="prompt_timeliness" rows="2"><%= item.prompt_timeliness %></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-add">Save changes</button>
    <a href="/literature" class="btn btn-cancel">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
