<%- include('../partials/header', { active: 'risks' }) %>

<h1>Edit risk</h1>

<% if (msg) { %>
  <div class="feedback-msg" role="status"><%= msg %></div>
<% } %>

<form method="post" action="/risks/<%= risk.id %>" class="form-card">
  <div class="form-group">
    <label for="description">Risk description <span class="required">*</span></label>
    <input type="text" id="description" name="description" required value="<%= risk.description %>">
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="likelihood">Likelihood</label>
      <select id="likelihood" name="likelihood">
        <% ['Low','Medium','High'].forEach(l => { %>
          <option value="<%= l %>" <%= risk.likelihood === l ? 'selected' : '' %>><%= l %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label for="impact">Impact</label>
      <select id="impact" name="impact">
        <% ['Low','Medium','High'].forEach(i => { %>
          <option value="<%= i %>" <%= risk.impact === i ? 'selected' : '' %>><%= i %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div class="form-group">
    <label for="mitigation">Mitigation strategy</label>
    <textarea id="mitigation" name="mitigation" rows="3"><%= risk.mitigation %></textarea>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="review_date">Review date</label>
      <input type="date" id="review_date" name="review_date" value="<%= risk.review_date || '' %>">
    </div>
    <div class="form-group">
      <label for="status">Status</label>
      <select id="status" name="status">
        <% ['Open','Closed'].forEach(s => { %>
          <option value="<%= s %>" <%= risk.status === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-add">Save changes</button>
    <a href="/risks" class="btn btn-cancel">Cancel</a>
  </div>
</form>

<fieldset class="linked-fieldset">
  <legend>Linked tasks</legend>
  <p class="hint">Use this section to connect tasks to the risk above, either as affected by it or as a mitigation action against it.</p>
<div class="form-card">
  <% if (links.length === 0) { %>
    <p class="note-text">No tasks are linked to this risk yet.</p>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Task</th>
          <th scope="col">Relationship</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% links.forEach(link => { %>
          <tr>
            <td><%= link.title %></td>
            <td><%= link.relation_type === 'Mitigation' ? 'Mitigation action for this risk' : 'Affected if this risk occurs' %></td>
            <td>
              <form method="post" action="/risks/<%= risk.id %>/links/<%= link.task_id %>/delete">
                <button type="submit" class="btn btn-cancel btn-small">Remove link</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <% if (availableTasks.length > 0) { %>
    <form method="post" action="/risks/<%= risk.id %>/links" class="link-form">
      <div class="form-row">
        <div class="form-group">
          <label for="task_id">Task</label>
          <select id="task_id" name="task_id">
            <% availableTasks.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.title %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label for="relation_type">Relationship</label>
          <select id="relation_type" name="relation_type">
            <option value="Mitigation">Mitigation action for this risk</option>
            <option value="Affected">Affected if this risk occurs</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-add">Link task</button>
    </form>
  <% } %>
</div>
</fieldset>

<%- include('../partials/footer') %>
