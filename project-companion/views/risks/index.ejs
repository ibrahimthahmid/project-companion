<%- include('../partials/header', { active: 'risks' }) %>

<div class="page-header">
  <h1>Risks</h1>
  <a href="/risks/new" class="btn btn-add">+ Add Risk</a>
</div>

<% if (msg) { %>
  <div class="feedback-msg" role="status"><%= msg %></div>
<% } %>

<table class="data-table">
  <thead>
    <tr>
      <th scope="col">Description</th>
      <th scope="col">Likelihood</th>
      <th scope="col">Impact</th>
      <th scope="col">Mitigation actions</th>
      <th scope="col">Review date</th>
      <th scope="col">Status</th>
      <th scope="col">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% risks.forEach(risk => { %>
      <tr>
        <td><%= risk.description %></td>
        <td><%= risk.likelihood %></td>
        <td><%= risk.impact %></td>
        <td><% if (risk.mitigation_count === 0) { %>No mitigation linked<% } else { %><%= risk.mitigation_count %> linked task<%= risk.mitigation_count !== 1 ? 's' : '' %><% } %></td>
        <td><%= risk.review_date || '-' %></td>
        <td>
          <span class="status-badge status-<%= risk.status.toLowerCase() %>"><%= risk.status %></span>
        </td>
        <td class="actions">
          <a href="/risks/<%= risk.id %>/edit" class="btn btn-edit">Edit</a>
          <a href="/risks/<%= risk.id %>/delete" class="btn btn-delete">Delete</a>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<p class="count-text">Showing <%= risks.length %> risk<%= risks.length !== 1 ? 's' : '' %></p>

<%- include('../partials/footer') %>
